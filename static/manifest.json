{
  "manifest_version": 3,
  "name": "Forge Toolbox",
  "version": "0.1.0",
  "description": "Helper for Forge of Empires. Listens to game traffic, never sends requests to the game servers.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "unlimitedStorage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.forgeofempires.com/game/*"],
      "js": ["proxy.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.forgeofempires.com/game/*"],
      "js": ["marker.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.forgeofempires.com/game/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
